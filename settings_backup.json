// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "context_servers": {},
  "telemetry": {
    "diagnostics": true,
    "metrics": false
  },
  "vim_mode": true,
  "disable_ai": true,
  "buffer_font_family": "Symbols Nerd Font Mono",
  "ui_font_family": ".ZedMono",
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "VSCode Dark Modern"
  },
  "assistant": {
    "version": "1",
    "provider": {
      "name": "openai",
      "type": "openai",
      "defualt_model": "gpt-4-turbo-preview",
      "api_url": "https://127.0.0.1:11434/v1"
    }
  }
}
